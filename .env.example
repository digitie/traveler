# Database
POSTGRES_USER=traveler
POSTGRES_PASSWORD=traveler_secret
POSTGRES_DB=traveler_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://traveler:traveler_secret@db:5432/traveler_db
DATABASE_URL_SYNC=postgresql://traveler:traveler_secret@db:5432/traveler_db

# data.go.kr API
DATA_GO_KR_API_KEY=your_api_key_here

# data.ex.co.kr API (한국도로공사)
DATA_EX_API_KEY=your_api_key_here

# Kakao Maps JavaScript API Key
NEXT_PUBLIC_KAKAO_MAP_API_KEY=your_kakao_js_api_key_here

# PgAdmin
PGADMIN_DEFAULT_EMAIL=admin@traveler.local
PGADMIN_DEFAULT_PASSWORD=admin_secret

# Airflow
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql://traveler:traveler_secret@db:5432/airflow_db

# Telegram Bot (BotFather에서 발급받은 토큰)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
NOTIFY_INTERVAL_SECONDS=3600
